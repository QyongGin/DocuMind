# A.X 4.0 Light 1회차 학습 모델(ADR-0033, 이슈 #223). convert.sh·import.sh가 읽는다.
# 학습 서버에서 tools/train으로 학습하고 합친 폴더를 SOURCE_DIR로 주어 바꾼다(원본을 내려받지 않는다).
NAME=ax40light-r1
OLLAMA_NAME=ax40light-r1:q4km
QUANT=Q4_K_M
# 채팅 틀은 기반 모델과 같다. 학습도 같은 틀로 했다(tools/train/train_qlora.py가 확인한다)
TEMPLATE_DIR=deploy/models/ax40light
EXPECTED_PROMPT_TOKENS=6
