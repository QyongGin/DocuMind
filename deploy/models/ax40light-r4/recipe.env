# A.X 4.0 Light 4회차 학습 모델(ADR-0053, 이슈 #225: 3회차 어댑터를 이어 선호 학습). convert.sh·import.sh가 읽는다.
# 학습 서버에서 tools/train/train_dpo.py로 학습하고 합친 폴더를 SOURCE_DIR로 주어 바꾼다(원본을 내려받지 않는다).
NAME=ax40light-r4
OLLAMA_NAME=ax40light-r4:q4km
QUANT=Q4_K_M
# 채팅 틀은 기반 모델과 같다. 학습도 같은 틀로 했다(tools/train/train_dpo.py가 train_qlora.py와 같은 확인을 한다)
TEMPLATE_DIR=deploy/models/ax40light
EXPECTED_PROMPT_TOKENS=6
