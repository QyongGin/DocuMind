# A.X 4.0 Light 4비트판 등록 설정(ADR-0034·0036). convert.sh·import.sh가 읽는다.
NAME=ax40light
OLLAMA_NAME=ax40light:q4km
# 공식 원본: SKT가 Hugging Face에 올린 저장소와 변환에 쓴 커밋(2026-10-01)
HF_REPO=skt/A.X-4.0-Light
HF_REVISION=ba21c20ea1b31ded1ec3e2fb432335077dc4be98
QUANT=Q4_K_M
# 같은 원본·같은 변환 도구로 만든 파일의 SHA256(2026-10-01 변환, 2026-10-20 convert.sh로 다시 만들어 같음)
EXPECTED_SHA256=a1681e9b6de543835c7130cfc3673813bc5dc724f64ada8fb60d37cb2999f35b
# "안녕하세요" 한 마디를 공식 채팅 틀로 감쌌을 때의 입력 토큰 수. Ollama 틀이 같은 글을 만드는지 본다
EXPECTED_PROMPT_TOKENS=6
# AI 서버가 프롬프트 토큰을 세는 토크나이저(ai-server/tokenizer/ax40light/tokenizer.json)의 SHA256. 서버가 시작할 때 견주고
# 다르면 뜨지 않는다(#274). 채팅 틀 토큰 수는 EXPECTED_PROMPT_TOKENS에서 "안녕하세요"의 토큰 수를 뺀 값으로 계산한다
TOKENIZER_SHA256=4050a8c9791364e3a81b1b813a32a6423e09ba7608e2eada83cc73e28a92c0eb
