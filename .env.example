# DocuMind Docker Compose environment
# Copy this file to .env and replace every placeholder before running Docker Compose.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
MYSQL_DATABASE=documind

# Spring Security JWT
# Use a long random value of at least 32 bytes.
JWT_SECRET=change-me-long-random-jwt-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION=24h
JWT_REFRESH_TOKEN_EXPIRATION=7d

# Initial admin bootstrap
# Used only when the admin account does not exist yet.
DOCUMIND_ADMIN_USERNAME=admin
DOCUMIND_ADMIN_PASSWORD=change-me-admin-password

# Browser CORS origins accepted by Spring Boot.
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Backend waits for synchronous AI upload/query processing.
FASTAPI_CONNECT_TIMEOUT=5s
FASTAPI_RESPONSE_TIMEOUT=20m
FASTAPI_STREAM_TIMEOUT=20m
DOCUMENT_PROCESSING_ASYNC_ENABLED=true
DOCUMENT_PROCESSING_CORE_POOL_SIZE=1
DOCUMENT_PROCESSING_MAX_POOL_SIZE=1
DOCUMENT_PROCESSING_QUEUE_CAPACITY=20

# Public frontend binding on the Docker host.
# For a reverse proxy, use FRONTEND_HOST=127.0.0.1 and proxy to FRONTEND_PORT.
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=80

# Ollama models
OLLAMA_BASE_URL=http://ollama:11434
# 생성 모델: A.X 4.0 Light 4비트판(ADR-0034, Apache 2.0). Ollama 공개 목록에 없어 deploy/models/README.md 절차로
# 먼저 등록한다(ADR-0036). 비교 기준 Gemma 4 12B는 gemma4:12b-it-qat(공개 목록에서 내려받음).
OLLAMA_LLM_MODEL=ax40light:q4km
# 생성 결정론화. RAG 평가의 결정론 앵커 전제이므로 측정 시 0 으로 둔다.
OLLAMA_TEMPERATURE=0.0
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_EMBEDDING_WARMUP_ON_STARTUP=false
# 생성 문맥(프롬프트 + 답)과 임베딩 문맥을 따로 둔다. 임베딩하는 글은 거의 모두 1,400토큰 이하라 2,048이면 된다(전체 색인에서 넘는 글 2개).
OLLAMA_NUM_CTX=12288
OLLAMA_EMBEDDING_NUM_CTX=2048
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_THREAD=0

# AI server performance
CHUNK_SIZE=800
CHUNK_OVERLAP=80
CHUNK_MERGE_MIN_SIZE=300
TABLE_FACT_MAX_PER_CHUNK=40
TABLE_FACT_MAX_CHARS=420
EMBED_TABLE_RAW_CHUNKS=true
OPENDATALOADER_JSON_TABLE_FACTS_ENABLED=false
EMBEDDING_BATCH_SIZE=64
UPLOAD_READ_CHUNK_BYTES=1048576
BM25_INDEX_MAX_ENTRIES=50000

# RAG retrieval size. Higher values improve recall but increase prompt length and answer latency.
CHAT_DEFAULT_TOP_K=8
AI_DEFAULT_TOP_K=8
# 재순위(M2 3단계, #174). 비우면 끔. 켜려면 GPU 덮어쓰기와 --profile reranker 로 재순위 서버를 띄우고
# AI_RERANKER_URL=http://reranker:80 을 적는다. 재순위 서버 이미지는 GPU 세대에 맞춘다(RTX 40 계열 89-1.9, A10G 86-1.9).
AI_RERANKER_URL=
AI_RERANK_CANDIDATES=20
# 프롬프트 날짜 줄(ADR-0047, #273): 맨 위 세 줄(오늘과 학년도 학기, 지금 모집 중인 입시, 직전 입시)과
# 근거마다 '게시: YYYY-MM-DD', '학년도: YYYY'. 기본은 꺼짐 — 개발셋으로 오답률이 늘지 않는지 잰 뒤에 켠다.
AI_PROMPT_DATE_LINES_ENABLED=false
# 날짜 줄 계산에 쓰는 학년도 시작 월과 2학기 시작 월(1~12, 학년도 시작 월 < 2학기 시작 월). 잘못되면 AI 서버가 뜨지 않는다.
AI_ACADEMIC_YEAR_START_MONTH=3
AI_SECOND_SEMESTER_START_MONTH=9
# 근거 블록에 청크 원문을 늘 넣기(M2 개선 설계 A1, 측정용). 기본 false
AI_CONTEXT_FULL_TEXT_ENABLED=false
# 표 블록(#274): 표 번호가 있는 근거에 표 전체와 표 아래 주석을 한 블록으로 넣고, 표 사실 문장과 그것을 가리키는 지시문을 뺀다.
# 프롬프트는 A.X 토크나이저로 세어 문맥 길이를 넘을 때만 표를 줄인다. 기본 false(그 전 프롬프트 그대로)
AI_TABLE_BLOCK_ENABLED=false
# 같은 표를 합쳐 줄어든 근거 자리를 다음 순위 근거로 채운다(표 블록이 켜졌을 때만). 기본 false, 단계 B 측정 뒤 정한다
AI_TABLE_BLOCK_FILL_ENABLED=false
# 검색에 표 사실 청크를 쓴다(어휘 표 사실 검색, 벡터 검색의 표 사실 결과). 기본 true
AI_TABLE_FACT_RETRIEVAL_ENABLED=true
RERANKER_IMAGE_TAG=89-1.9
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
VITE_DEFAULT_TOP_K=8
VITE_API_BASE_URL=/api
